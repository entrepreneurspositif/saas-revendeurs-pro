generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Supplier {
  id               String            @id @default(cuid())
  name             String
  type             String            @default("canboso")
  apiUrl           String
  apiKey           String
  isActive         Boolean           @default(true)
  reliabilityScore Float             @default(99.0)
  balance          Float             @default(0.0)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  supplierProducts SupplierProduct[]
  orders           Order[]
}

model SupplierProduct {
  id             String    @id @default(cuid())
  supplierId     String
  externalId     String
  name           String
  description    String?
  productType    String?
  costPrice      Float
  currency       String    @default("USD")
  stock          Int       @default(0)
  sold           Int       @default(0)
  image          String?
  emoji          String?
  isAvailable    Boolean   @default(true)
  lastSyncedAt   DateTime  @default(now())
  supplier       Supplier  @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  masterProducts Product[]

  @@unique([supplierId, externalId])
}

model Product {
  id                      String           @id @default(cuid())
  title                   String
  slug                    String           @unique
  description             String?
  category                String           @default("Général")
  sellingPrice            Float
  currency                String           @default("USD")
  isActive                Boolean          @default(true)
  activeSupplierId        String?
  activeSupplierProductId String?
  imageUrl                String?
  badge                   String?
  deliveryType            String           @default("MANUAL")
  methodContent           String?
  createdAt               DateTime         @default(now())
  updatedAt               DateTime         @updatedAt
  activeSupplierProduct   SupplierProduct? @relation(fields: [activeSupplierProductId], references: [id], onDelete: SetNull)
  orders                  Order[]
  tenantPrices            TenantProductPrice[]
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  name          String
  role          String   @default("CUSTOMER")
  walletBalance Float    @default(100.0)
  createdAt     DateTime @default(now())
  orders        Order[]
}

model Order {
  id                   String    @id @default(cuid())
  userId               String
  productId            String
  productTitle         String
  supplierId           String?
  supplierProductId    String?
  ticketCode           String    @unique @default(cuid())
  quantity             Int       @default(1)
  unitCostPrice        Float
  unitSellingPrice     Float
  totalAmount          Float
  profitMargin         Float
  status               String    @default("PENDING_PAYMENT")
  deliveredCredentials String?
  paymentInstructions  String?
  errorMessage         String?
  idempotencyKey       String
  supplierOrderRef     String?
  supportStatus        String    @default("OPEN")
  tenantId             String?
  resellerProfit       Float     @default(0.0)
  platformProfit       Float     @default(0.0)
  createdAt            DateTime  @default(now())
  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  product              Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier             Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  tenant               Tenant?   @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  messages             ChatMessage[]
}

model ChatMessage {
  id         String   @id @default(cuid())
  ticketCode String
  sender     String   // "CUSTOMER" or "ADMIN"
  text       String
  createdAt  DateTime @default(now())

  order      Order    @relation(fields: [ticketCode], references: [ticketCode], onDelete: Cascade)
}

model Setting {
  key   String @id
  value String
}

model OtpOrder {
  id                  String   @id @default(cuid())
  ticketCode          String   @unique @default(cuid())
  tzid                Int      @default(0)
  phone               String   @default("")
  service             String
  country             String   @default("1")
  costPrice           Float    @default(0)
  sellingPrice        Float    @default(0)
  status              String   @default("PENDING_PAYMENT")
  paymentInstructions String?
  errorMessage        String?
  smsCode             String?
  fullSms             String?
  tenantId            String?
  customerEmail       String?
  customerName        String?
  customerPhone       String?
  resellerProfit      Float    @default(0)
  platformProfit      Float    @default(0)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  tenant              Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
}

model ProductRequest {
  id           String   @id @default(cuid())
  customerName String
  contactInfo  String
  productName  String
  description  String?
  status       String   @default("PENDING")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model PromoCode {
  id                String    @id @default(cuid())
  code              String    @unique
  discountType      String    @default("PERCENTAGE")
  discountValue     Float
  minPurchaseAmount Float     @default(0.0)
  maxUses           Int?
  usedCount         Int       @default(0)
  isActive          Boolean   @default(true)
  expiresAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model VisitLog {
  id        String   @id @default(cuid())
  tenantId  String?
  path      String
  userAgent String?
  ipHash    String?
  referrer  String?
  device    String   @default("desktop")
  createdAt DateTime @default(now())

  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([path])
  @@index([tenantId])
}

model SaasPlan {
  id                    String    @id // "free", "starter", "pro"
  name                  String    // "Free", "Starter", "Pro"
  description           String?
  priceMonthly          Float     @default(0.0)
  priceYearly           Float     @default(0.0)
  currency              String    @default("USD")
  marginDiscountPercent Float     @default(0.0) // 0 for free, 35 for starter, 60 for pro
  features              String    @default("[]") // JSON array of enabled feature keys
  isActive              Boolean   @default(true)
  sortOrder             Int       @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  tenants               Tenant[]
}

model Tenant {
  id                  String               @id @default(cuid())
  email               String               @unique
  password            String
  name                String
  subdomain           String               @unique
  customDomain        String?              @unique
  planId              String               @default("free")
  planStatus          String               @default("ACTIVE") // ACTIVE, EXPIRED, TRIAL, SUSPENDED
  planExpiresAt       DateTime?
  storeName           String               @default("Ma Boutique")
  tagline             String?              @default("Boutique officielle de licences et abonnements")
  logoUrl             String?
  bannerUrl           String?
  themeColor          String               @default("sky")
  themePreset         String?              @default("cyber-dark")
  fontFamily          String?              @default("Inter")
  buttonColor         String?              @default("#0284c7")
  buttonTextColor     String?              @default("#ffffff")
  buttonRadius        String?              @default("rounded-xl")
  contactEmail        String?
  contactPhone        String?
  contactWhatsApp     String?
  contactTelegram     String?
  bannerAnnouncement  String?
  paymentInstructions String?
  facebookPixelId     String?
  tiktokPixelId       String?
  googleAnalyticsId   String?
  welcomeMessage      String?
  floatingChatEnabled Boolean              @default(true)
  feexpayApiKey       String?
  feexpayShopId       String?
  feexpayEnabled      Boolean              @default(false)
  monerooSecretKey    String?
  monerooEnabled      Boolean              @default(false)
  customGatewayEnabled Boolean             @default(false)
  otpMarginPercent    Float?               @default(30.0)
  telegramBotToken             String?
  telegramChatId               String?
  telegramNotificationsEnabled Boolean              @default(false)
  notifyOnNewOrder             Boolean              @default(true)
  notifyOnOtpOrder             Boolean              @default(true)
  notifyOnSupportReply         Boolean              @default(true)
  notifyOnPayout               Boolean              @default(true)
  walletBalance       Float                @default(0.0)
  totalEarnings       Float                @default(0.0)
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  plan                SaasPlan             @relation(fields: [planId], references: [id])
  customPrices        TenantProductPrice[]
  orders              Order[]
  otpOrders           OtpOrder[]
  otpServices         TenantOtpService[]
  visitLogs           VisitLog[]
  tickets             ResellerTicket[]
}

model TenantProductPrice {
  id                 String   @id @default(cuid())
  tenantId           String
  productId          String
  customSellingPrice Float?
  isEnabled          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([tenantId, productId])
}

model TenantOtpService {
  id                 String   @id @default(cuid())
  tenantId           String
  serviceCode        String
  country            String   @default("all")
  customSellingPrice Float?
  isEnabled          Boolean  @default(true)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  tenant             Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@unique([tenantId, serviceCode, country])
  @@index([tenantId, country])
}

model ResellerTicket {
  id         String                  @id @default(cuid())
  ticketCode String                  @unique
  tenantId   String
  subject    String
  category   String                  @default("GENERAL") // GENERAL, ORDERS, COMMISSIONS, TECHNICAL, CATALOG
  priority   String                  @default("MEDIUM")  // LOW, MEDIUM, HIGH, URGENT
  status     String                  @default("OPEN")    // OPEN, IN_PROGRESS, RESOLVED, CLOSED
  createdAt  DateTime                @default(now())
  updatedAt  DateTime                @updatedAt
  tenant     Tenant                  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messages   ResellerTicketMessage[]

  @@index([tenantId])
  @@index([status])
  @@index([createdAt])
}

model ResellerTicketMessage {
  id         String         @id @default(cuid())
  ticketId   String
  senderRole String         // "RESELLER" | "SUPER_ADMIN"
  senderName String
  message    String
  createdAt  DateTime       @default(now())
  ticket     ResellerTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)

  @@index([ticketId])
  @@index([createdAt])
}


